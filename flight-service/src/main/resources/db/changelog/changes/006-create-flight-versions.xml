<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="006-1" author="alikaracor">

        <createTable tableName="flight_versions">

            <column
                    name="flight_version_id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_flight_versions"
                        nullable="false"/>
            </column>

            <column name="flight_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="flight_version_number" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="flight_number" type="VARCHAR(6)">
                <constraints nullable="false"/>
            </column>

            <column name="airline_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="aircraft_id" type="BIGINT"/>

            <column name="aircraft_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="origin_airport_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="destination_airport_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="flight_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="flight_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="scheduled_departure_time" type="TIME(6)">
                <constraints nullable="false"/>
            </column>

            <column name="scheduled_arrival_time" type="TIME(6)">
                <constraints nullable="false"/>
            </column>

            <column name="flight_status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="flight_change_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="changed_by_user_id" type="BIGINT"/>

            <column name="flight_version_created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="flight_versions"
                baseColumnNames="flight_id"
                referencedTableName="flights"
                referencedColumnNames="flight_id"
                constraintName="fk_flight_versions_flight"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <addUniqueConstraint
                tableName="flight_versions"
                columnNames="flight_id, flight_version_number"
                constraintName="uc_flight_versions_flight_version"/>

        <createIndex
                tableName="flight_versions"
                indexName="idx_flight_versions_flight_id">
            <column name="flight_id"/>
        </createIndex>

        <createIndex
                tableName="flight_versions"
                indexName="idx_flight_versions_created_at">
            <column name="flight_version_created_at"/>
        </createIndex>

        <createIndex
                tableName="flight_versions"
                indexName="idx_flight_versions_changed_by_user_id">
            <column name="changed_by_user_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>