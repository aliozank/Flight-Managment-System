<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="005-1" author="alikaracor">

        <createTable tableName="flights">

            <column
                    name="flight_id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_flights"
                        nullable="false"/>
            </column>

            <column name="flight_number" type="VARCHAR(6)">
                <constraints nullable="false"/>
            </column>

            <column name="airline_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="aircraft_id" type="BIGINT"/>

            <column name="aircraft_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="origin_airport_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="destination_airport_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="flight_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="flight_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="scheduled_departure_time" type="TIME(6)">
                <constraints nullable="false"/>
            </column>

            <column name="scheduled_arrival_time" type="TIME(6)">
                <constraints nullable="false"/>
            </column>

            <column
                    name="flight_status"
                    type="VARCHAR(30)"
                    defaultValue="SCHEDULED">
                <constraints nullable="false"/>
            </column>

            <column
                    name="flight_version"
                    type="INT"
                    defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>

            <column name="flight_created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>

            <column name="flight_updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addUniqueConstraint
                tableName="flights"
                columnNames="flight_number, flight_date"
                constraintName="uc_flights_number_date"/>

        <createIndex
                tableName="flights"
                indexName="idx_flights_airline_id">
            <column name="airline_id"/>
        </createIndex>

        <createIndex
                tableName="flights"
                indexName="idx_flights_aircraft_id">
            <column name="aircraft_id"/>
        </createIndex>

        <createIndex
                tableName="flights"
                indexName="idx_flights_flight_date">
            <column name="flight_date"/>
        </createIndex>

        <createIndex
                tableName="flights"
                indexName="idx_flights_route">
            <column name="origin_airport_id"/>
            <column name="destination_airport_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>