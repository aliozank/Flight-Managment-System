<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="012-1" author="alikaracor">
        <addColumn tableName="outbox_events">
            <column name="lock_token" type="VARCHAR(36)"/>
            <column name="locked_until" type="DATETIME(6)"/>
        </addColumn>

        <createIndex indexName="idx_outbox_status_locked_until" tableName="outbox_events">
            <column name="status"/>
            <column name="locked_until"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
