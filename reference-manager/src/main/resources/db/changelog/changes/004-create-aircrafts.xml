<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="004-1" author="alikaracor">
        <createTable tableName="aircrafts">
            <column name="aircraft_id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_aircrafts"/>
            </column>
            <column name="aircraft_registration_number" type="VARCHAR(20)">
                <constraints
                        nullable="false"
                        unique="true"
                        uniqueConstraintName="uc_aircrafts_registration_number"/>
            </column>
            <column name="operator_airline_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="aircraft_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="aircraft_capacity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="aircraft_manufacture_year" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="aircraft_status" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="aircraft_created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="aircraft_updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="aircrafts"
                baseColumnNames="operator_airline_id"
                referencedTableName="airlines"
                referencedColumnNames="airline_id"
                constraintName="fk_aircrafts_operator_airline"/>

        <addForeignKeyConstraint
                baseTableName="aircrafts"
                baseColumnNames="aircraft_type_id"
                referencedTableName="aircraft_types"
                referencedColumnNames="aircraft_type_id"
                constraintName="fk_aircrafts_aircraft_type"/>
    </changeSet>

</databaseChangeLog>
