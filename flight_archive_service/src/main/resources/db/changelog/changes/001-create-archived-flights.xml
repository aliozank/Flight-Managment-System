<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="001-1" author="alikaracor">

        <createTable tableName="archived_flights">

            <column name="archive_id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_archived_flights"
                        nullable="false"/>
            </column>

            <column name="event_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="flight_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="flight_number" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <column name="airline_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="aircraft_id" type="BIGINT"/>

            <column name="aircraft_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="origin_airport_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="destination_airport_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="flight_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="flight_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="scheduled_departure_time" type="TIME">
                <constraints nullable="false"/>
            </column>

            <column name="scheduled_arrival_time" type="TIME">
                <constraints nullable="false"/>
            </column>

            <column name="flight_status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="flight_version" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="changed_by_user_id" type="BIGINT"/>

            <column name="event_occurred_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="archived_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addUniqueConstraint
                tableName="archived_flights"
                columnNames="event_id"
                constraintName="uc_archived_flights_event_id"/>

        <addUniqueConstraint
                tableName="archived_flights"
                columnNames="flight_id"
                constraintName="uc_archived_flights_flight_id"/>

        <createIndex
                tableName="archived_flights"
                indexName="idx_archived_flights_status">
            <column name="flight_status"/>
        </createIndex>

        <createIndex
                tableName="archived_flights"
                indexName="idx_archived_flights_date">
            <column name="flight_date"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>